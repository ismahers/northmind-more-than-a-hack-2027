{
  "version": "live-ball-validation-v1",
  "part": "validation",
  "folds": [0, 6],
  "scenarios": ["clean", "missing40_5s", "missing40_15s"],
  "weights": [0.5, 0.25, 0.25],
  "views": [[false, false], [false, true], [true, false], [true, true]],
  "fps": 25.0,
  "model_fps": 10.0,
  "cpu_threads": 4,
  "max_seconds": 3600,
  "train_models": false,
  "fit_transition_prior_on_train": true,
  "test_access": false,
  "target_access": false,
  "parameter_search": false,
  "binary_hmm_strength": 0.5,
  "preserve_geometric_dead": true,
  "neutral_tagging": true,
  "memory_enabled": false,
  "target_prior_policy_if_promoted": "equal_average_of_fold_0_and_6_transition_probabilities",
  "guardrails": {
    "robust_delta_min": 0.005,
    "clean_delta_min": 0.0,
    "short_recall_delta_min": 0.0,
    "long_recall_delta_min": -0.01,
    "macro_f1_delta_min": -0.005,
    "false_transitions_delta_max": 0.0
  },
  "scope": "Exploratory IDSSE validation ablation with neutral tactical priors; not end-to-end validation of the target submission",
  "decision": "One fixed live/dead hypothesis; no automatic promotion or tuning after validation metrics"
}
