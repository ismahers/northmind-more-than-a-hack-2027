  "fallback": false,
  "deterministic_algorithms": true,
  "epoch_scope": "One fresh training epoch per repetition; no validation, scoring or checkpoint writes. Includes corruption, windows, collation, packing, transfers, loss, clipping, optimizer and per-batch telemetry. Not a full 12+8 training run.",
  "public_only": "Only existing explicit public external manifest/processed artifacts; synthetic fallback if unavailable; no downloading or historical checkpoint access."
