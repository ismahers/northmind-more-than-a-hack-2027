{
  "version": "mps-benchmark-v1",
  "seed": 2027,
  "cpu_threads": 4,
  "batch_size": 4,
  "core_frames": 256,
  "context": 15,
  "dtype": "float32",
  "warmup_steps": 3,
  "profile_repetitions": 7,
  "epoch_repetitions": 3,
  "repeatability_updates": 3,
  "synthetic_windows": 48,
  "max_seconds": 900,
  "max_epoch_seconds": 120,
